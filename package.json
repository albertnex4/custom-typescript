{
  "name": "custom-typescript",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "build:ui": "vite build",
    "build:client": "rollup -c rollup.client.config.cjs",
    "build": "npm run build:ui && npm run build:client",
    "dev:ui": "vite dev --mode development",
    "dev:client:ui": "vite build --watch --config vite.config.ts",
    "dev:client": "rollup -c rollup.client.config.cjs -w",
    "dev:server": "cd dist && nodemon --ext js --exec ragemp-server.exe",
    "dev": "concurrently \"npm run dev:client:ui\" \"npm run dev:client\" \"npm run dev:server\"",
    "i18n:types": "node ./src/tools/generate-translation-types.cjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@ragempcommunity/types-cef": "^2.1.9",
    "@ragempcommunity/types-client": "^2.1.9",
    "@rollup/plugin-commonjs": "^25.0.8",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^15.3.1",
    "@rollup/plugin-terser": "^0.4.3",
    "@rollup/plugin-typescript": "^11.1.6",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.6",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^9.2.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "rollup": "^3.29.5",
    "typescript": "^5.9.3",
    "vite": "^7.2.4",
    "vite-plugin-static-copy": "^3.1.4"
  },
  "dependencies": {
    "nodemon": "^3.1.11",
    "tslib": "^2.8.1"
  }
}
