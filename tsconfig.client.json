{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "outDir": "dist/client_packages",
    "strict": true,
    "jsx": "react-jsx",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "importHelpers": true,          // <--- RECOMENDADO
    "noEmitHelpers": true,           // <--- evita duplicar helpers

    /* Configuración de Tipos */
    "types": ["./node_modules/@ragempcommunity/types-client"]
  },
  "include": ["src/client/modules/**/*.ts", "src/client/modules/**/*.tsx", "src/client/types/**/*.d.ts", "src/shared/**/*.json", "src/shared/**/*.ts"],
  "exclude": ["node_modules", "src/client/ui"]
}
