{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "strict": true,
    "jsx": "react-jsx",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "importHelpers": true,          // <--- RECOMENDADO
    "noEmitHelpers": true           // <--- evita duplicar helpers
  },
  "include": ["src/client/modules/**/*.ts", "src/client/modules/**/*.tsx", "src/client/types/**/*.d.ts"],
  "exclude": ["node_modules"]
}
